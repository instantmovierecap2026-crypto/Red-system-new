rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to validate registration structure
    function isValidRegistration(data) {
      return data.full_name is string && 
             data.full_name.size() > 0 &&
             data.promoted_grade in [10, 11, 12] &&
             data.tracking_id is string;
    }

    match /registrations/{regId} {
      // Anyone can submit a new registration
      allow create: if isValidRegistration(request.resource.data);
      
      // Students can lookup their status. 
      // Note: Without Auth, this is open, but we expect the client to filter by tracking_id.
      allow read: if true;

      // In this specific "No-Auth" requirement, we allow public updates for the dashboard to function,
      // but in production, these actions should be proxied through a secure backend server.
      allow update: if true; 
      allow delete: if true;
    }

    match /grade_settings/{gradeId} {
      allow read: if true;
      allow write: if true; 
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if true;
    }

    match /admin_logs/{logId} {
      allow create: if true;
      allow read: if false;
    }
  }
}
